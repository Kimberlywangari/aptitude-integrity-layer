# Copy to .env and fill in. .env is git-ignored; this example file is committed.
# Lines with no value are secrets or keys that you must supply. Nothing here is a working secret.

# --- Where this runs ---------------------------------------------------------------------------
# development: this laptop. production: the server (the API then refuses to start unless the
# secret, the https address and the recording gate below are right).
ENV=development
# The address candidates open; used to build invitation links. Production: the https:// address.
PUBLIC_BASE_URL=http://localhost:5173
# Signs every login and link. Production: required, 32+ random characters. Make one with
#   py -3.13 -c "import secrets; print(secrets.token_urlsafe(48))"
# Development: leave empty and a new one is made on each start.
SESSION_SECRET=

# --- Database ------------------------------------------------------------------------------------
# Development: the Compose Postgres on host port 5433 (5432 is taken by a local Postgres).
DATABASE_URL=postgresql+psycopg://integrity:integrity@localhost:5433/integrity
TEST_DATABASE_URL=postgresql+psycopg://integrity:integrity@localhost:5433/integrity_test
# Production (docker-compose.prod.yml): the database password.
POSTGRES_PASSWORD=

# --- The camera and microphone gate --------------------------------------------------------------
#   off        the test begins without a pre-check (automated tests only)
#   precheck   begin needs a passing POST /api/precheck/result
#   recording  also needs a real video and audio chunk already uploaded (use this for real tests)
# A server with ENV=production refuses to start unless this is "recording".
PRECHECK_GATE=recording

# --- Video, retention and the upload window ------------------------------------------------------
# A relative path is read from the repository root, not from wherever uvicorn was started.
VIDEO_ROOT=./data/video
RETENTION_DAYS=30
# How long after finishing a candidate may still upload (48 hours).
RESUME_WINDOW_S=172800
# Finished sessions with video and no decision, older than this, are listed by purge_videos --report.
UNDECIDED_REPORT_DAYS=60
# Automated tests only: the fraction of chunk uploads to fail on purpose. Ignored in production.
CHUNK_FAIL_RATE=0

# --- ffmpeg: joins uploaded chunks into video that seeks, and scans the audio for muted stretches
# Full path to ffmpeg.exe, written without quotes. Leave empty to use the one on PATH.
FFMPEG_BIN=
MIC_SILENCE_DB=-65
MIC_SERVER_MIN_SILENCE_SECONDS=60

# --- AI ranking: rules | ollama | claude ---------------------------------------------------------
#   rules   no AI; flagged candidates are ordered by the rule score
#   ollama  a model on this machine (no cost)
#   claude  Claude through the API (needs ANTHROPIC_API_KEY; see docs/plan/ai-provider-switch.md)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Measured on the dev laptop (docs/spikes/ollama-benchmark.md): `ollama pull gemma4:e2b`
OLLAMA_MODEL=gemma4:e2b
# One packet through the model.
AI_TIMEOUT_S=150
CLAUDE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- AI-written questions: a sitting can have its questions written for each candidate -----------
# ollama | claude. Ollama writes with QUESTION_OLLAMA_MODEL (empty: OLLAMA_MODEL); Claude writes
# with CLAUDE_MODEL and ANTHROPIC_API_KEY. A local model on a CPU takes about a minute a question.
QUESTION_PROVIDER=ollama
QUESTION_OLLAMA_MODEL=qwen3:8b
# One call writes a handful of questions or checks them; seconds for Claude, minutes on a slow CPU.
QUESTION_TIMEOUT_S=300
# How many candidates' papers are written at the same time.
QUESTION_WORKERS=2
# A candidate who has waited this many seconds for their questions is offered a way to ask again.
QUESTION_WAIT_LIMIT_S=600
# Writing one paper stops with an error after this many seconds (what was written is kept, and the
# candidate or an admin can ask again), so nothing runs for ever.
QUESTION_PAPER_TIMEOUT_S=1800
# Each written question is answered again this many times, without its key and with the options in a
# different order, and is used only if every answer agrees with it (1 to 3). Stricter is slower.
QUESTION_SOLVES=2

# --- Email: invitations and result emails (guide: docs/plan/email-setup.md) ---------------------------
# Leave SMTP_HOST empty and nothing is sent: emails wait in a queue and the admin page says so.
# Gmail: smtp.gmail.com, port 587, an app password. Microsoft 365: smtp.office365.com, port 587,
# and your organisation must allow "SMTP AUTH" for the mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# The account's password, or for Gmail an "app password". Never commit it; this file is only the example.
SMTP_PASSWORD=
# The address candidates see. Most providers only allow the account's own address here.
MAIL_FROM=
MAIL_FROM_NAME=Cytonn Aptitude Test
# Where a candidate is told to write to appeal a result. Empty: they are told to write to MAIL_FROM.
APPEAL_EMAIL=

# --- The question bank (job fetch_cytonn_bank): Cytonn's read-only aptitude API ---------------------
APTITUDE_API_BASE_URL=https://hr.cytonn.com/api/aptitude
# The key Cytonn issued. It stays in .env and is never printed or logged.
X-API-KEY=
# On a server use this name for the same key: Compose cannot carry a name with dashes.
APTITUDE_API_KEY=

# --- Production only (docker-compose.prod.yml) -----------------------------------------------------
# The public host name that the HTTPS proxy gets a certificate for, for example aptitude.company.com.
SITE_ADDRESS=
# Who may open the staff console (/admin, /review and their data). Space-separated addresses or
# ranges, for example "203.0.113.0/24 198.51.100.7". Empty means everybody, which is how it starts
# until the company's network ranges are known. Candidates are never affected. A wrong list locks
# the staff out: fix it here and run `docker compose -f docker-compose.prod.yml up -d proxy`.
STAFF_ALLOWED_IPS=
# Encrypt the backups (deploy/backup.sh): a key id or address in the server's gpg keyring. Only the
# public half of the key goes on the server; keep the private half safe, because restoring needs it.
# Empty: backups are stored unencrypted. See README, "Backups, restoring, and knowing when it is down".
BACKUP_GPG_RECIPIENT=
