# Copy to .env and edit. .env is git-ignored; this example file is committed.

ENV=development

# --- Database (Compose Postgres is on host port 5433 because 5432 is taken by a local Postgres) ---
DATABASE_URL=postgresql+psycopg://integrity:integrity@localhost:5433/integrity
TEST_DATABASE_URL=postgresql+psycopg://integrity:integrity@localhost:5433/integrity_test

# --- The address candidates open; used to build invitation links ---
PUBLIC_BASE_URL=http://localhost:5173
SESSION_SECRET=change-me-dev-only

# --- Video (D7) and retention (D14) ---
VIDEO_ROOT=./data/video
RETENTION_DAYS=30
# Dev only: fraction of chunk uploads to fail on purpose (D8). Ignored when ENV=production.
CHUNK_FAIL_RATE=0

# --- AI ranking (D11-D12): rules | ollama | claude ---
AI_PROVIDER=rules
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
CLAUDE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
