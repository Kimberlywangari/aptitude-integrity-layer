# Copy to .env and edit. .env is git-ignored; this example file is committed.

ENV=development

# --- Database (Compose Postgres is on host port 5433 because 5432 is taken by a local Postgres) ---
DATABASE_URL=postgresql+psycopg://integrity:integrity@localhost:5433/integrity
TEST_DATABASE_URL=postgresql+psycopg://integrity:integrity@localhost:5433/integrity_test

# --- The address candidates open; used to build invitation links ---
PUBLIC_BASE_URL=http://localhost:5173
SESSION_SECRET=change-me-dev-only

# --- The camera and microphone gate (the proposal's one automatic outcome) ---
#   off        the test begins without a pre-check (development, while the screens use fixtures)
#   precheck   begin needs a passing POST /api/precheck/result
#   recording  also needs a real video and audio chunk already uploaded
# A server with ENV=production refuses to start unless this is "recording".
PRECHECK_GATE=off

# --- Video, retention and the upload window ---
# A relative path is read from the repository root, not from wherever uvicorn was started.
VIDEO_ROOT=./data/video
RETENTION_DAYS=30
# How long after finishing a candidate may still upload (48 hours).
RESUME_WINDOW_S=172800
# Finished sessions with video and no decision, older than this, are listed by purge_videos --report.
UNDECIDED_REPORT_DAYS=60
# Dev only: fraction of chunk uploads to fail on purpose (D8). Ignored when ENV=production.
CHUNK_FAIL_RATE=0

# --- ffmpeg: joins uploaded chunks into video that seeks, and scans the audio for muted stretches ---
# Leave empty to use the one on PATH.
FFMPEG_BIN=
MIC_SILENCE_DB=-65
MIC_SERVER_MIN_SILENCE_SECONDS=60

# --- AI ranking (D11-D12): rules | ollama | claude ---
AI_PROVIDER=rules
OLLAMA_BASE_URL=http://localhost:11434
# Chosen by measurement on the dev laptop (docs/spikes/ollama-benchmark.md): `ollama pull gemma4:e2b`
OLLAMA_MODEL=gemma4:e2b
# One packet through the model; the plan's limit is under two minutes.
AI_TIMEOUT_S=150
CLAUDE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
